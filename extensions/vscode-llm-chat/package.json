{
  "name": "vscode-llm-chat",
  "displayName": "Synora Studio",
  "description": "Connect VS Code to Synora Studio",
  "version": "2.0.0",
  "engines": {
    "vscode": "^1.116.0"
  },
  "categories": [
    "AI",
    "Chat"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/Arean82/synora_studio"
  },
  "activationEvents": [],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "llmchat.sendFile",
        "title": "LLM Chat: Send Current File"
      },
      {
        "command": "llmchat.sendSelection",
        "title": "LLM Chat: Send Selected Code"
      },
      {
        "command": "llmchat.sendProject",
        "title": "LLM Chat: Send Entire Project"
      },
      {
        "command": "llmchat.applyEdit",
        "title": "LLM Chat: Apply AI Suggestion"
      },
      {
        "command": "llmchat.fixCode",
        "title": "LLM Chat: Fix This Code"
      },
      {
        "command": "llmchat.explainCode",
        "title": "LLM Chat: Explain This Code"
      },
      {
        "command": "llmchat.terminalCommand",
        "title": "LLM Chat: Generate Terminal Command"
      },
      {
        "command": "llmchat.explainError",
        "title": "LLM Chat: Explain Error"
      },
      {
        "command": "llmchat.generateCommit",
        "title": "LLM Chat: Generate Commit Message"
      },
      {
        "command": "llmchat.generateDocstring",
        "title": "LLM Chat: Generate Docstring"
      },
      {
        "command": "llmchat.generateTests",
        "title": "LLM Chat: Generate Unit Tests"
      },
      {
        "command": "llmchat.onboard",
        "title": "LLM Chat: Onboard / Configure API"
      }
    ],
    "configuration": {
      "title": "Synora Studio Settings",
      "properties": {
        "llmChat.apiUrl": {
          "type": "string",
          "default": "http://localhost:5000",
          "description": "The base server URL (e.g. http://localhost:5000 or https://saas.quantum.net)"
        },
        "llmChat.apiToken": {
          "type": "string",
          "default": "llm-local-auth-82c4f3eb0d",
          "description": "Your API Bearer Token / Passport Key (stored securely in VS Code secrets if configured via onboarding)"
        }
      }
    },
    "menus": {
      "editor/context": [
        {
          "command": "llmchat.sendSelection",
          "when": "editorHasSelection",
          "group": "LLM Chat"
        },
        {
          "command": "llmchat.sendFile",
          "group": "LLM Chat"
        },
        {
          "command": "llmchat.fixCode",
          "when": "editorHasSelection",
          "group": "LLM Chat"
        },
        {
          "command": "llmchat.explainCode",
          "when": "editorHasSelection",
          "group": "LLM Chat"
        },
        {
          "command": "llmchat.generateDocstring",
          "when": "editorHasSelection",
          "group": "LLM Chat"
        },
        {
          "command": "llmchat.generateTests",
          "when": "editorHasSelection",
          "group": "LLM Chat"
        }
      ]
    }
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./"
  },
  "devDependencies": {
    "@types/node": "^25.6.0",
    "@types/vscode": "^1.116.0",
    "typescript": "^5.9.3"
  }
}
