[Unit]
Description=Synora Backend Service Test Description
After=network-online.target mysql.service postgresql.service
Wants=network-online.target

[Service]
Type=simple
User=root
Group=root
WorkingDirectory=c:\Users\user\OneDrive\Desktop\python\llm_chat_app
EnvironmentFile=/etc/synora-test-service-linux/.env
ExecStart=python "c:\Users\user\OneDrive\Desktop\python\llm_chat_app\main.py" --headless
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
StartLimitBurst=5
StartLimitIntervalSec=10
LimitNOFILE=65536
MemoryMax=2G

# Enterprise Security Hardening
PrivateTmp=yes
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=c:\Users\user\OneDrive\Desktop\python\llm_chat_app /var/log/synora-test-service-linux
CapabilityBoundingSet=CAP_NET_BIND_SERVICE

[Install]
WantedBy=multi-user.target
