flowchart TD
    %% Styling Classes
    classDef main fill:#1e1e2e,stroke:#89b4fa,stroke-width:2px,color:#cdd6f4;
    classDef companion fill:#181825,stroke:#f9e2af,stroke-width:2px,color:#cdd6f4;
    classDef storage fill:#313244,stroke:#a6e3a1,stroke-width:2px,color:#cdd6f4;
    classDef process fill:#11111b,stroke:#fab387,stroke-width:2px,color:#cdd6f4;

    subgraph App1 ["📱 App 1: Synora Studio (Main GUI/Headless)"]
        UI["⚙️ Settings Panel Admin Console"]:::main
        Trigger["🚀 Click 'Operator Tools Dashboard'"]:::main
        Spawn["Spawn subprocess:<br>operator_tools/companion/companion_operation.py"]:::process
        Close["🚪 Terminate Main App Process<br>(Release Database Locks)"]:::process
    end

    subgraph App2 ["🛠️ App 2: Unified Operator Tools Dashboard (MVC)"]
        CompanionUI["🖥️ Master Multi-Tab Dialog / CLI Console"]:::companion
        
        %% Tab 1
        SaaSMigrate["Tab 1: SaaS DB Relocator<br>Relocate schema, Jaccard verify, update config.ini"]:::companion
        
        %% Tab 2
        LocalReloc["Tab 2: Local Storage Relocator (core/local_relocator.py)<br>Transactional OS Path Wizard"]:::companion
        
        %% Tab 3
        SvcInstall["Tab 3: Service Setup Wizard (core/service_installer.py)<br>Install as Native OS Daemons"]:::companion

        Relaunch["Spawn subprocess: main.py"]:::process
        Exit["🚪 Terminate Companion App Process"]:::process
    end

    subgraph Infrastructure ["🗄️ System & Database Infrastructure"]
        Turso["⚡ Turso / libSQL (saas_tenants.db)"]:::storage
        EnterpriseSQL["💾 Target SQL Backend (PostgreSQL / MySQL)"]:::storage
        FileSystem["📁 OS Local File System / Drives"]:::storage
        OSService["⚙️ Native OS Service Manager (systemd/Windows)"]:::storage
    end

    UI --> Trigger
    Trigger --> Spawn
    Spawn --> Close
    Close -->|Releases DB Handles| Turso
    Close -->|Releases DB Handles| FileSystem
    Spawn -.->|Launches| CompanionUI
    
    CompanionUI --> SaaSMigrate
    CompanionUI --> LocalReloc
    CompanionUI --> SvcInstall
    
    SaaSMigrate -->|Reads/Egresses| Turso
    SaaSMigrate -->|Ingresses/Audits| EnterpriseSQL
    
    LocalReloc -->|Transactional Pathing| FileSystem
    
    SvcInstall -->|Installs Daemons| OSService

    SaaSMigrate --> Relaunch
    LocalReloc --> Relaunch
    SvcInstall --> Relaunch

    Relaunch --> Exit
    Relaunch -.->|Restarts| UI
